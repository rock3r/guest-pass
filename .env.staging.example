# Staging environment — copy to .env.staging (or .env on a staging-only host) and fill in real values.
# NEVER commit a file with real secrets.
#
# COMPOSE_PROJECT_NAME namespaces all containers and volumes so staging and prod
# can run side-by-side on the same host without colliding.
COMPOSE_PROJECT_NAME=guestpass-staging

# External URL served by Cloudflare (must be https://).
BASE_URL=https://staging.guest-pass.link

# Google OAuth — create a Web Application client in Google Cloud Console.
# Add https://staging.guest-pass.link/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Strong random secrets — generate with: openssl rand -base64 48
# TOKEN_SECRET is stable (do not rotate it).
JWT_SECRET=<run: openssl rand -base64 48>
TOKEN_SECRET=<run: openssl rand -base64 48>

# First sign-in matching ADMIN_EMAIL is auto-approved as owner/admin.
ADMIN_EMAIL=<your-email>

# Allowlist mode: only the listed addresses may sign in.
SIGNUP_MODE=allowlist
ALLOWED_HOSTS=<your-email>

# Public STUN — no port-forwarding required for staging.
STUN_URL=stun:stun.cloudflare.com:3478

# Mail — print magic links to stdout (docker compose logs guestpass).
# Remove this line and set RESEND_API_KEY + MAIL_FROM to enable real email delivery.
MAIL_MODE=log
# RESEND_API_KEY=<your-resend-api-key>
# MAIL_FROM=GuestPass Staging <staging@guest-pass.link>

# Cloudflare Tunnel credentials are stored in cloudflared/config.yml and
# cloudflared/credentials.json (gitignored). Run scripts/cf-tunnel-setup.sh once
# to create them. No env var needed here.
