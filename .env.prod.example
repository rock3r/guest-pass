# Production environment — copy to .env.prod (or .env on a prod-only host) and fill in real values.
# NEVER commit a file with real secrets.
#
# COMPOSE_PROJECT_NAME namespaces all containers and volumes so prod and staging
# can run side-by-side on the same host without colliding.
COMPOSE_PROJECT_NAME=guestpass-prod

# External URL served by Cloudflare (must be https://).
BASE_URL=https://guest-pass.link

# Google OAuth — the same client used for prod (or a separate one).
# Authorised redirect URI must include: https://guest-pass.link/auth/google/callback
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Strong random secrets — generate with: openssl rand -base64 48
# TOKEN_SECRET is stable (do not rotate it; rotating orphans every stored token hash).
JWT_SECRET=<run: openssl rand -base64 48>
TOKEN_SECRET=<run: openssl rand -base64 48>

# First sign-in matching ADMIN_EMAIL is auto-approved as owner/admin.
ADMIN_EMAIL=<your-email>

# Open signup for the public instance (D-36 progressive trust handles abuse).
SIGNUP_MODE=open

# Public STUN — no port-forwarding required when TURN is disabled (D-38).
# Replace with your own coturn if you later enable the turn profile.
STUN_URL=stun:stun.cloudflare.com:3478

# Email delivery — pick one backend (both need MAIL_FROM).
#
# Option A: generic SMTP relay (recommended for self-hosting)
# Brevo free tier: smtp-relay.brevo.com:587 (300 emails/day)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<brevo-login-email>
# SMTP_PASS=<brevo-smtp-key>
# MAIL_FROM=GuestPass <invites@guest-pass.link>
#
# Option B: Resend HTTP API
# RESEND_API_KEY=<your-resend-api-key>
# MAIL_FROM=GuestPass <invites@guest-pass.link>

# Cloudflare Tunnel credentials are stored in cloudflared/config.yml and
# cloudflared/credentials.json (gitignored). Run scripts/cf-tunnel-setup.sh once
# to create them. No env var needed here.
